---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  title="Halaman Tidak Ditemukan | PT Prasetya Tour and Travel"
  description="Halaman yang Anda cari tidak tersedia. Jelajahi layanan perjalanan eksklusif PT Prasetya Tour and Travel di halaman utama."
  noindex
>
  <main class="flex min-h-screen items-center justify-center px-6 text-center">
    <div>
      <img
        src="/logos/symbol_logo_lightmode.svg"
        alt=""
        width="1500"
        height="1500"
        class="mx-auto mb-6 h-14 w-14"
        aria-hidden="true"
        loading="lazy"
      />
      <p class="text-xs font-semibold tracking-[0.25em] text-brand-700 uppercase">
        Kesalahan 404
      </p>
      <h1 class="mt-3 font-serif text-4xl text-slate-900 sm:text-5xl">
        Rute Halaman
        <span class="font-normal italic text-brand-700">Tidak Ditemukan</span>
      </h1>
      <p class="mx-auto mt-4 max-w-md text-sm font-light text-slate-600">
        Halaman yang Anda tuju tidak tersedia. Mari kembali ke jalur utama
        perjalanan eksklusif Anda bersama PT Prasetya Tour.
      </p>
      <a
        class="mt-8 inline-flex items-center rounded-full bg-slate-900 px-8 py-3 text-xs font-semibold tracking-widest text-white uppercase shadow-md transition-colors duration-300 hover:bg-brand-700"
        href="/"
      >
        Kembali ke Beranda
      </a>
    </div>
  </main>
</BaseLayout>
