---
import Icon from "@/components/Icon.astro";
import { site, wa } from "@/data/site";
---

<section class="relative w-full py-20" id="kontak">
  <div class="mx-auto max-w-7xl px-6 sm:px-8 lg:px-12">
    <div
      class="relative overflow-hidden rounded-3xl bg-slate-900 p-8 text-white shadow-2xl sm:p-12 lg:p-16"
    >
      <div
        class="pointer-events-none absolute -top-20 -right-20 h-96 w-96 rounded-full bg-brand-700/30 blur-3xl"
        aria-hidden="true"
      >
      </div>
      <div class="relative z-10 grid grid-cols-1 items-center gap-8 lg:grid-cols-12">
        <div class="space-y-4 lg:col-span-8">
          <img
            src="/logos/completelogo_darkmode.svg"
            alt={site.name}
            width="2250"
            height="750"
            class="h-10 w-auto sm:h-12"
          />
          <span
            class="block text-xs font-semibold tracking-[0.25em] text-brand-200 uppercase"
          >
            Konsultasi Rute Bebas Biaya
          </span>
          <h2
            class="text-3xl font-medium leading-tight tracking-tight text-white sm:text-4xl lg:text-5xl"
          >
            Siap Mewujudkan Perjalanan
            <br />
            <span class="font-serif font-normal italic text-brand-200"
              >Istimewa Tanpa Kompromi?</span
            >
          </h2>
          <p
            class="max-w-xl text-sm font-light leading-relaxed text-slate-300 sm:text-base"
          >
            Hubungi concierge {site.name} hari ini. Rancang rute impian
            rombongan Anda dan dapatkan proposal penawaran harga terbaik dalam
            waktu 24 jam.
          </p>
          <div class="flex flex-wrap items-center gap-4 pt-4">
            <a
              class="inline-flex items-center gap-3 rounded-full bg-white px-8 py-4 text-xs font-semibold tracking-widest text-slate-900 uppercase shadow-lg transition-all duration-300 hover:bg-brand-50 hover:text-brand-700"
              target="_blank"
              rel="noopener noreferrer"
              href={
                wa(
                  "Halo Prasetya Tour, saya ingin mendapatkan proposal perjalanan wisata."
                )
              }
            >
              <Icon name="chat" size="text-lg" class="text-brand-700" />
              <span>Hubungi WhatsApp: {site.phoneDisplay}</span>
            </a>
            <span
              class="text-xs font-medium tracking-widest text-slate-400 uppercase"
            >
              Respon Cepat 24/7
            </span>
          </div>
        </div>

        <div
          class="space-y-4 rounded-2xl border border-white/10 bg-white/10 p-6 backdrop-blur-md lg:col-span-4"
        >
          <div>
            <span
              class="block text-[11px] font-semibold tracking-wider text-brand-200 uppercase"
            >
              Kantor Operasional
            </span>
            <address
              class="mt-1 text-xs leading-relaxed text-slate-200 not-italic sm:text-sm"
            >
              {site.addressLine}
            </address>
          </div>
          <div class="space-y-2 border-t border-white/10 pt-3 text-xs text-slate-300">
            <p class="flex items-center gap-2">
              <Icon name="schedule" size="text-sm" class="text-brand-200" />
              <span>{site.hours}</span>
            </p>
            <p class="flex items-center gap-2">
              <Icon name="support_agent" size="text-sm" class="text-brand-200" />
              <span>{site.hoursNote}</span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
