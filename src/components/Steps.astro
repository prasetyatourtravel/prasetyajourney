---
import { Image } from "astro:assets";
import { steps, images } from "@/data/site";
---

<section
  class="relative w-full border-y border-slate-200/60 py-16 sm:py-24"
  id="proses"
>
  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
    <Image
      src={images.stepsBackdrop}
      alt="Pantai tropis Indonesia dengan perahu tradisional dan air laut jernih kebiruan"
      widths={[640, 1024, 1376]}
      sizes="100vw"
      format="webp"
      quality={70}
      loading="lazy"
      class="h-full w-full object-cover object-center contrast-[1.02] opacity-90 saturate-120"
    />
    <div
      class="pointer-events-none absolute inset-0 bg-gradient-to-b from-sky-950/15 via-transparent to-[#faf9f6]/40"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-[#faf9f6] via-[#faf9f6]/80 to-transparent"
    >
    </div>
  </div>

  <div class="relative z-10 mx-auto max-w-7xl px-6 sm:px-8 lg:px-12">
    <div class="mx-auto mb-16 max-w-2xl text-center">
      <span
        class="mb-2 block text-xs font-semibold tracking-[0.25em] text-brand-700 uppercase"
      >
        Metodologi Presisi
      </span>
      <h2
        class="font-serif text-3xl font-normal leading-tight text-slate-900 sm:text-4xl lg:text-5xl"
      >
        5 Langkah Mudah
        <span class="font-normal italic text-brand-700"
          >Reservasi Perjalanan</span
        >
      </h2>
      <p class="mt-3 text-sm font-light text-slate-600 sm:text-base">
        Tata kelola operasional terstruktur dari inisiasi ide hingga
        kepulangan rombongan Anda dengan rasa puas.
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-5">
      {
        steps.map((step) => (
          <div class="glass-card-subtle group relative flex flex-col justify-between rounded-2xl p-6 transition-all duration-500 hover:-translate-y-1.5 hover:border-brand-500/40 hover:shadow-xl">
            <div>
              <span class="mb-4 block font-serif text-4xl font-normal text-slate-400/80 transition-colors duration-300 group-hover:text-brand-700">
                {step.index}
              </span>
              <h3 class="mb-2 text-base font-semibold text-slate-900 transition-colors duration-300 group-hover:text-brand-700">
                {step.title}
              </h3>
              <p class="text-xs leading-relaxed font-light text-slate-700">
                {step.description}
              </p>
            </div>
            <span class="mt-6 border-t border-slate-200/60 pt-4 text-[11px] font-semibold tracking-widest text-brand-700 uppercase transition-colors duration-300 group-hover:text-brand-800">
              {step.phase}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>
