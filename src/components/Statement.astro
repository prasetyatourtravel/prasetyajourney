---
---

<section class="relative w-full py-20 sm:py-28">
  <div class="mx-auto max-w-5xl px-6 text-center sm:px-8">
    <img
      src="/logos/symbol_logo_lightmode.svg"
      alt=""
      width="1500"
      height="1500"
      class="mx-auto mb-10 h-16 w-16"
      aria-hidden="true"
      loading="lazy"
    />
    <h2
      class="text-3xl leading-[1.3] font-medium tracking-tight text-slate-900 sm:text-4xl md:text-5xl lg:text-[54px]"
    >
      Kami hadir
      <span class="font-serif font-normal italic text-brand-700"
        >menginspirasi</span
      >
      setiap langkah perjalanan Anda ke
      <span
        class="font-serif font-normal text-slate-950 underline decoration-slate-300 underline-offset-8"
        >Nusantara</span
      >
      dengan standar
      <span class="font-serif font-normal italic text-slate-800"
        >kenyamanan tanpa kompromi</span
      >, menyatukan
      <span class="font-serif font-normal italic text-brand-800"
        >ketepatan jadwal</span
      >
      dan kehangatan pelayanan sepenuh hati.
    </h2>
    <div
      class="mt-10 flex flex-wrap items-center justify-center gap-4 text-xs font-medium tracking-widest text-slate-500 uppercase"
    >
      <span>Standar Eksekutif</span>
      <span class="h-1 w-1 rounded-full bg-slate-300"></span>
      <span>Legalitas Sah Kemenkumham</span>
      <span class="h-1 w-1 rounded-full bg-slate-300"></span>
      <span>Tour Leader Bersertifikasi</span>
    </div>
  </div>
</section>
