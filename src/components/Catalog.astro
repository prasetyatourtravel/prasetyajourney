---
import { Image } from "astro:assets";
import Icon from "@/components/Icon.astro";
import { catalogFilters, services, wa } from "@/data/site";
---

<section class="relative w-full py-24" id="layanan-destinasi">
  <div class="mx-auto max-w-7xl px-6 sm:px-8 lg:px-12">
    <div
      class="mb-12 flex flex-col justify-between gap-6 md:flex-row md:items-end"
    >
      <div>
        <span
          class="mb-2 block text-xs font-semibold tracking-[0.25em] text-brand-700 uppercase"
        >
          Kurasi Pilihan
        </span>
        <h2
          class="text-3xl font-medium tracking-tight text-slate-900 sm:text-4xl lg:text-5xl"
        >
          Katalog Layanan &amp;
          <span class="font-serif font-normal italic text-brand-700"
            >Destinasi Favorit</span
          >
        </h2>
      </div>
      <p class="max-w-md text-sm font-light leading-relaxed text-slate-600 sm:text-base">
        Pilihan rencana perjalanan komprehensif mulai dari study tour edukasi,
        liburan keluarga mewah, hingga penyewaan armada bus pariwisata
        eksekutif.
      </p>
    </div>

    <div
      class="mb-8 flex items-center gap-2 overflow-x-auto pb-4"
      id="catalog-filters"
      role="group"
      aria-label="Filter katalog layanan"
    >
      {
        catalogFilters.map((filter, i) => (
          <button
            type="button"
            class:list={[
              "filter-btn rounded-full px-5 py-2 text-xs font-semibold tracking-wider whitespace-nowrap uppercase transition-all",
              i === 0 && "filter-active",
            ]}
            data-filter={filter.id}
            aria-pressed={i === 0 ? "true" : "false"}
          >
            {filter.label}
          </button>
        ))
      }
    </div>

    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3" id="catalog-cards">
      {
        services.map((service) => (
          <article
            class="catalog-card glass-card-subtle group flex flex-col overflow-hidden rounded-3xl transition-all duration-500 hover:-translate-y-1.5 hover:border-brand-500/40 hover:shadow-2xl"
            data-category={service.category}
          >
            <div class="relative h-64 w-full overflow-hidden">
              <Image
                src={service.img}
                alt={service.alt}
                widths={[400, 700, 1408]}
                sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                format="webp"
                quality={75}
                loading="lazy"
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 via-transparent to-transparent" />
              <div class="absolute right-4 bottom-4 left-4 flex items-center justify-between text-white">
                <span class="text-[11px] font-semibold tracking-widest text-white/90 uppercase">
                  {service.overlayLabel}
                </span>
                <span class="text-xs font-medium text-white/90">
                  {service.overlayMeta}
                </span>
              </div>
            </div>
            <div class="flex flex-1 flex-col justify-between p-6">
              <div>
                <span class="mb-1 block text-[11px] font-semibold tracking-wider text-brand-700 uppercase">
                  {service.location}
                </span>
                <h3 class="font-serif text-xl text-slate-900 transition-colors duration-300 group-hover:text-brand-700">
                  {service.title}
                </h3>
                <p class="mt-2.5 text-xs leading-relaxed font-light text-slate-600 sm:text-sm">
                  {service.description}
                </p>
              </div>
              <div class="mt-6 flex items-center justify-between border-t border-slate-100 pt-4">
                <span class="text-xs font-semibold text-slate-900">
                  {service.footerLabel}
                </span>
                <a
                  class="group/link inline-flex items-center gap-1.5 text-xs font-semibold text-brand-700 hover:text-brand-800"
                  href={wa(service.waText)}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Konsultasi
                  <Icon
                    name="arrow_forward"
                    size="text-[15px]"
                    class="transition-transform duration-300 group-hover/link:translate-x-1"
                  />
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<script>
  const filterButtons =
    document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const catalogCards = document.querySelectorAll<HTMLElement>(".catalog-card");

  filterButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      filterButtons.forEach((b) => {
        b.classList.remove("filter-active");
        b.setAttribute("aria-pressed", "false");
      });
      btn.classList.add("filter-active");
      btn.setAttribute("aria-pressed", "true");

      const filter = btn.dataset.filter;
      catalogCards.forEach((card) => {
        card.style.display =
          filter === "all" || card.dataset.category === filter ? "flex" : "none";
      });
    });
  });
</script>
